rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/systemAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/systemAdmins/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/systemAdmins/$(request.auth.uid)).data.role in ["owner", "admin"];
    }
    function walletPath(uid) {
      return /databases/$(database)/documents/walletAccounts/$(uid);
    }
    function operationPath(operationId) {
      return /databases/$(database)/documents/walletOperations/$(operationId);
    }
    function validAmount(amount) {
      return amount is number && amount > 0 && amount <= 50000;
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isSystemAdmin();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Wallet accounts are private. A new account receives one fixed fictitious
    // welcome credit; clients cannot choose a larger starting balance.
    match /walletAccounts/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isSystemAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.balance == 50000
        && request.resource.data.cashbackTotal == 0
        && request.resource.data.depositedTotal == 0
        && request.resource.data.alias is string
        && request.resource.data.cvu is string
        && request.resource.data.lastOperationId == "welcome";

      allow update: if (
        signedIn()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.alias == resource.data.alias
        && request.resource.data.cvu == resource.data.cvu
        && changedOnly(["balance", "depositedTotal", "lastOperationId", "updatedAt"])
        && request.resource.data.lastOperationId is string
        && existsAfter(operationPath(request.resource.data.lastOperationId))
        && (
          (
            getAfter(operationPath(request.resource.data.lastOperationId)).data.kind == "DEPOSIT"
            && request.auth.uid == userId
            && getAfter(operationPath(request.resource.data.lastOperationId)).data.senderUid == userId
            && request.resource.data.balance == resource.data.balance
              + getAfter(operationPath(request.resource.data.lastOperationId)).data.amount
            && request.resource.data.depositedTotal == resource.data.depositedTotal
              + getAfter(operationPath(request.resource.data.lastOperationId)).data.amount
          )
          ||
          (
            getAfter(operationPath(request.resource.data.lastOperationId)).data.kind in ["TRANSFER", "QR_PAYMENT"]
            && request.auth.uid == getAfter(operationPath(request.resource.data.lastOperationId)).data.senderUid
            && (
              (
                userId == getAfter(operationPath(request.resource.data.lastOperationId)).data.senderUid
                && request.resource.data.balance == resource.data.balance
                  - getAfter(operationPath(request.resource.data.lastOperationId)).data.amount
                && request.resource.data.depositedTotal == resource.data.depositedTotal
              )
              ||
              (
                userId == getAfter(operationPath(request.resource.data.lastOperationId)).data.recipientUid
                && request.resource.data.balance == resource.data.balance
                  + getAfter(operationPath(request.resource.data.lastOperationId)).data.amount
                && request.resource.data.depositedTotal == resource.data.depositedTotal
              )
            )
          )
        )
      ) || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.cvu == resource.data.cvu
        && request.resource.data.alias is string
        && request.resource.data.alias.matches('^[a-z0-9][a-z0-9._-]{2,29}$')
        && resource.data.alias != request.resource.data.alias
        && changedOnly(["alias", "updatedAt"])
        && existsAfter(/databases/$(database)/documents/walletDirectory/$(request.resource.data.alias))
        && getAfter(/databases/$(database)/documents/walletDirectory/$(request.resource.data.alias)).data.uid == userId
        && !existsAfter(/databases/$(database)/documents/walletDirectory/$(resource.data.alias))
      );

      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.operationId == transactionId
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status == "APROBADA · DEMO"
          && (
            (
              transactionId == "welcome"
              && request.auth.uid == userId
              && request.resource.data.amount == 50000
              && getAfter(walletPath(userId)).data.balance == 50000
            )
            ||
            (
              existsAfter(operationPath(transactionId))
              && request.auth.uid == getAfter(operationPath(transactionId)).data.senderUid
              && (
                userId == getAfter(operationPath(transactionId)).data.senderUid
                || userId == getAfter(operationPath(transactionId)).data.recipientUid
              )
              && request.resource.data.amount == getAfter(operationPath(transactionId)).data.amount
            )
          );
        allow update, delete: if false;
      }
    }

    // Public lookup data contains only fictitious account identifiers.
    match /walletDirectory/{alias} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.alias == alias
        && request.resource.data.cvu is string;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.alias == alias
        && request.resource.data.cvu == resource.data.cvu;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // OMNI CONEX: job, professional, trade and local-service listings.
    // Listings are visible to signed-in users; only the publisher can edit or remove them.
    // Demo merchant ownership. The first authenticated account to activate a
    // store profile claims it for this sandbox; this is not real-world verification.
    match /merchantProfiles/{storeId} {
      function validCashbackPolicy() {
        return request.resource.data.cashback is map
          && request.resource.data.cashback.keys().hasAll([
            "enabled", "percentage", "capPerPurchase", "monthlyCap"
          ])
          && request.resource.data.cashback.keys().hasOnly([
            "enabled", "percentage", "capPerPurchase", "monthlyCap"
          ])
          && request.resource.data.cashback.enabled is bool
          && request.resource.data.cashback.percentage is number
          && request.resource.data.cashback.percentage >= 0
          && request.resource.data.cashback.percentage <= 100
          && (!request.resource.data.cashback.enabled
            || request.resource.data.cashback.percentage > 0)
          && (request.resource.data.cashback.capPerPurchase == null
            || (request.resource.data.cashback.capPerPurchase is number
              && request.resource.data.cashback.capPerPurchase > 0))
          && (request.resource.data.cashback.monthlyCap == null
            || (request.resource.data.cashback.monthlyCap is number
              && request.resource.data.cashback.monthlyCap > 0));
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.storeId == storeId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storeName is string
        && request.resource.data.environment == "DEMO"
        && validCashbackPolicy();
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.environment == "DEMO"
        && (!("environment" in resource.data.keys()) || request.resource.data.environment == resource.data.environment)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["cashback"])
          || validCashbackPolicy());
      allow delete: if false;
    }

    // Card gateway attempts are sandbox-only and never contain PAN, CVV or real tokens.
    match /demoCardPayments/{paymentId} {
      function linkedOrder() {
        return get(/databases/$(database)/documents/storeOrders/$(request.resource.data.orderId)).data;
      }
      allow read: if isSystemAdmin() || (signedIn()
        && (resource.data.customerUid == request.auth.uid
          || resource.data.merchantUid == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "paymentId", "orderId", "customerUid", "merchantUid", "amount",
          "cardBrand", "provider", "status", "environment", "createdAt"
        ])
        && request.resource.data.paymentId == paymentId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.merchantUid is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 50000
        && request.resource.data.cardBrand in ["VISA", "MASTERCARD"]
        && request.resource.data.provider == "OMNI_DEMO_GATEWAY"
        && request.resource.data.status in ["APROBADA · DEMO", "RECHAZADA · DEMO"]
        && request.resource.data.environment == "DEMO"
        && request.resource.data.createdAt is timestamp
        && linkedOrder().customerUid == request.auth.uid
        && linkedOrder().merchantUid == request.resource.data.merchantUid
        && linkedOrder().environment == "DEMO"
        && linkedOrder().paymentStatus == "PENDIENTE"
        && linkedOrder().createdAt is timestamp
        && request.time < linkedOrder().createdAt + duration.value(24, 'h')
        && linkedOrder().total == request.resource.data.amount;
      allow update, delete: if false;
    }

    // QR codes identify orders only. They never confirm payment.
    match /storeOrders/{orderId} {
      function merchantProfilePath() {
        return /databases/$(database)/documents/merchantProfiles/$(resource.data.storeId);
      }
      function validCashbackSnapshot() {
        let profile = get(/databases/$(database)/documents/merchantProfiles/$(request.resource.data.storeId)).data;
        let snapshot = request.resource.data.cashbackPolicy;
        return snapshot is map
          && snapshot.keys().hasAll(["enabled", "percentage", "capPerPurchase", "monthlyCap"])
          && snapshot.keys().hasOnly(["enabled", "percentage", "capPerPurchase", "monthlyCap"])
          && snapshot.enabled is bool
          && snapshot.percentage is number
          && snapshot.percentage >= 0
          && snapshot.percentage <= 100
          && (!snapshot.enabled || snapshot.percentage > 0)
          && (snapshot.capPerPurchase == null
            || (snapshot.capPerPurchase is number && snapshot.capPerPurchase > 0))
          && (snapshot.monthlyCap == null
            || (snapshot.monthlyCap is number && snapshot.monthlyCap > 0))
          && (
            (profile.cashback is map && snapshot == profile.cashback)
            || (
              !("cashback" in profile.keys())
              && snapshot.enabled == false
              && snapshot.percentage == 0
              && snapshot.capPerPurchase == null
              && snapshot.monthlyCap == null
            )
          );
      }
      function validNextStatus() {
        return
          (resource.data.status == "RECIBIDO" && request.resource.data.status == "ACEPTADO") ||
          (resource.data.status == "RECIBIDO" && request.resource.data.status == "RECHAZADO" && resource.data.paymentStatus == "PENDIENTE") ||
          (resource.data.status == "ACEPTADO" && request.resource.data.status == "EN_PREPARACION") ||
          (resource.data.status == "ACEPTADO" && request.resource.data.status == "CANCELADO" && resource.data.paymentStatus == "PENDIENTE") ||
          (resource.data.status == "EN_PREPARACION" && request.resource.data.status == "LISTO") ||
          (resource.data.status == "EN_PREPARACION" && request.resource.data.status == "CANCELADO" && resource.data.paymentStatus == "PENDIENTE") ||
          (resource.data.status == "LISTO" && request.resource.data.status in ["EN_CAMINO", "ENTREGADO"]) ||
          (resource.data.status == "EN_CAMINO" && request.resource.data.status == "ENTREGADO");
      }
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.merchantUid is string
        && request.resource.data.merchantUid != request.auth.uid
        && request.resource.data.storeId is string
        && request.resource.data.environment == "DEMO"
        && request.resource.data.status == "RECIBIDO"
        && request.resource.data.paymentStatus == "PENDIENTE"
        && request.resource.data.paymentMethod == "PAGO_AL_RETIRAR"
        && request.resource.data.fulfillmentType in ["RETIRO", "DELIVERY"]
        && (request.resource.data.fulfillmentType == "RETIRO"
          || (request.resource.data.deliveryAddress is string && request.resource.data.deliveryAddress.size() > 0))
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total <= 50000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.qrNonce is string
        && request.resource.data.qrNonce.size() >= 20
        && get(/databases/$(database)/documents/merchantProfiles/$(request.resource.data.storeId)).data.ownerUid
          == request.resource.data.merchantUid
        && get(/databases/$(database)/documents/merchantProfiles/$(request.resource.data.storeId)).data.environment == "DEMO"
        && validCashbackSnapshot();
      // Queries must constrain customerUid or merchantUid to the signed-in user.
      // merchantUid is copied from the claimed merchant profile at order creation.
      allow read: if isSystemAdmin() || (signedIn()
        && (resource.data.customerUid == request.auth.uid
          || resource.data.merchantUid == request.auth.uid));
      // El comercio solo avanza el estado operativo del pedido.
      // El cliente solo puede confirmar el pago si el ledger y ambos saldos
      // se actualizan en la misma transacción DEMO.
      allow update: if (
        signedIn()
        && get(merchantProfilePath()).data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.total == resource.data.total
        && request.resource.data.qrNonce == resource.data.qrNonce
        && validNextStatus()
      ) || (
        signedIn()
        && request.auth.uid == resource.data.customerUid
        && resource.data.paymentStatus == "PENDIENTE"
        && resource.data.createdAt is timestamp
        && request.time < resource.data.createdAt + duration.value(24, 'h')
        && request.resource.data.paymentStatus == "PAGADA · DEMO"
        && request.resource.data.paymentMethod == "OMNI_PAY_DEMO"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus", "paymentMethod", "updatedAt"])
        && request.resource.data.status == resource.data.status
        && request.resource.data.total == resource.data.total
        && request.resource.data.qrNonce == resource.data.qrNonce
        && resource.data.status in ["RECIBIDO", "ACEPTADO", "EN_PREPARACION", "LISTO", "EN_CAMINO"]
        && existsAfter(operationPath("orderpay_" + orderId))
        && getAfter(operationPath("orderpay_" + orderId)).data.operationId == "orderpay_" + orderId
        && getAfter(operationPath("orderpay_" + orderId)).data.kind == "QR_PAYMENT"
        && getAfter(operationPath("orderpay_" + orderId)).data.senderUid == request.auth.uid
        && getAfter(operationPath("orderpay_" + orderId)).data.recipientUid == resource.data.merchantUid
        && getAfter(operationPath("orderpay_" + orderId)).data.orderId == orderId
        && getAfter(operationPath("orderpay_" + orderId)).data.amount == resource.data.total
      ) || (
        signedIn()
        && request.auth.uid == resource.data.customerUid
        && resource.data.paymentStatus == "PENDIENTE"
        && resource.data.createdAt is timestamp
        && request.time < resource.data.createdAt + duration.value(24, 'h')
        && request.resource.data.paymentStatus == "PAGADA · DEMO"
        && request.resource.data.paymentMethod == "TARJETA_DEMO"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentStatus", "paymentMethod", "cardPaymentId", "updatedAt"])
        && request.resource.data.status == resource.data.status
        && request.resource.data.total == resource.data.total
        && request.resource.data.qrNonce == resource.data.qrNonce
        && request.resource.data.cardPaymentId is string
        && existsAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId))
        && getAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId)).data.paymentId == request.resource.data.cardPaymentId
        && getAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId)).data.customerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId)).data.merchantUid == resource.data.merchantUid
        && getAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId)).data.amount == resource.data.total
        && getAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId)).data.provider == "OMNI_DEMO_GATEWAY"
        && getAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId)).data.status == "APROBADA · DEMO"
        && getAfter(/databases/$(database)/documents/demoCardPayments/$(request.resource.data.cardPaymentId)).data.environment == "DEMO"
      ) || (
        signedIn()
        && request.auth.uid == resource.data.customerUid
        && resource.data.status == "RECIBIDO"
        && resource.data.paymentStatus == "PENDIENTE"
        && request.resource.data.status == "CANCELADO"
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
      );
      allow delete: if false;
    }

    // OMNI Momentos: private dates and greeting drafts owned by one account.
    match /omniMoments/{momentId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.occasion in ["Cumpleaños", "Aniversario", "Graduación", "Otra fecha"]
        && request.resource.data.personName is string
        && request.resource.data.personName.size() > 0
        && request.resource.data.personName.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{2}/\\d{2}/\\d{4}$')
        && request.resource.data.greeting is string
        && request.resource.data.greeting.size() <= 1000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["occasion", "personName", "date", "greeting", "note", "status", "updatedAt"]);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // OMNI Events: authenticated community calendar.
    match /omniEvents/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.location is string
        && request.resource.data.dateTime is string
        && request.resource.data.status == "PUBLISHED";
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // OMNI CONEX professional profiles. Public visibility is an explicit owner choice.
    match /omniProfessionalProfiles/{profileUid} {
      allow read: if signedIn()
        && (request.auth.uid == profileUid || resource.data.visibility == "PUBLIC");
      allow create: if signedIn()
        && request.auth.uid == profileUid
        && request.resource.data.ownerUid == profileUid
        && request.resource.data.profession is string
        && request.resource.data.profession.size() > 0
        && request.resource.data.profession.size() <= 100
        && request.resource.data.skills is string
        && request.resource.data.skills.size() <= 1000
        && request.resource.data.experience is string
        && request.resource.data.experience.size() <= 1000
        && request.resource.data.education is string
        && request.resource.data.education.size() <= 500
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 100
        && request.resource.data.availability in ["Disponible", "Buscando activamente", "Freelance", "No disponible"]
        && request.resource.data.cvLink is string
        && request.resource.data.cvLink.size() <= 1500
        && request.resource.data.visibility in ["PUBLIC", "PRIVATE"]
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && request.auth.uid == profileUid
        && resource.data.ownerUid == profileUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && changedOnly(["profession", "skills", "experience", "education", "location", "availability", "cvLink", "visibility", "updatedAt"])
        && request.resource.data.visibility in ["PUBLIC", "PRIVATE"];
      allow delete: if false;
    }

    match /jobPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 3000
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.expiresAt is timestamp;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && changedOnly(["title", "description", "category", "location", "workType", "experience", "remuneration", "workSchedule", "contactPhone", "contactEmail", "status", "expiresAt", "updatedAt"])
        && request.resource.data.status in ["ACTIVE", "CLOSED"];
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /jobApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postOwnerUid is string
        && request.resource.data.postOwnerUid != request.auth.uid
        && get(/databases/$(database)/documents/jobPosts/$(request.resource.data.postId)).data.ownerUid
          == request.resource.data.postOwnerUid;
      allow read: if isSystemAdmin() || (signedIn()
        && (applicationId.matches("^" + request.auth.uid + "_.*")
          || resource.data.applicantUid == request.auth.uid
          || resource.data.postOwnerUid == request.auth.uid));
      allow update: if signedIn()
        && resource.data.postOwnerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["RECIBIDA", "EN_REVISION", "ACEPTADA", "RECHAZADA"];
      allow delete: if signedIn() && resource.data.applicantUid == request.auth.uid;
    }

    // The operation record ties both balance changes together atomically.
    match /walletOperations/{operationId} {
      allow read: if isSystemAdmin() || (signedIn()
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid));

      allow create: if signedIn()
        && request.resource.data.operationId == operationId
        && request.resource.data.senderUid == request.auth.uid
        && validAmount(request.resource.data.amount)
        && (
          (
            request.resource.data.kind == "DEPOSIT"
            && request.resource.data.recipientUid == request.auth.uid
            && get(walletPath(request.auth.uid)).data.depositedTotal
              + request.resource.data.amount <= 150000
            && getAfter(walletPath(request.auth.uid)).data.balance
              == get(walletPath(request.auth.uid)).data.balance + request.resource.data.amount
            && getAfter(walletPath(request.auth.uid)).data.depositedTotal
              == get(walletPath(request.auth.uid)).data.depositedTotal + request.resource.data.amount
          )
          ||
          (
            request.resource.data.kind in ["TRANSFER", "QR_PAYMENT"]
            && request.resource.data.recipientUid is string
            && request.resource.data.recipientUid != request.auth.uid
            && get(walletPath(request.auth.uid)).data.balance >= request.resource.data.amount
            && getAfter(walletPath(request.auth.uid)).data.balance
              == get(walletPath(request.auth.uid)).data.balance - request.resource.data.amount
            && getAfter(walletPath(request.resource.data.recipientUid)).data.balance
              == get(walletPath(request.resource.data.recipientUid)).data.balance + request.resource.data.amount
          )
        );
      allow update, delete: if false;
    }

    // OMNI Admin: authorization documents are provisioned manually by the project owner.
    match /systemAdmins/{adminUid} {
      allow read: if signedIn() && request.auth.uid == adminUid;
      allow create, update, delete: if false;
    }

    match /adminConfig/{configId} {
      allow read, write: if isSystemAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isSystemAdmin();
      allow create: if isSystemAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /moduleRegistry/{moduleId} {
      allow read, write: if isSystemAdmin();
    }

    match /betaInvitations/{invitationId} {
      allow read, write: if isSystemAdmin();
    }

    // Approximate presence is opt-in, owner-writable, and administrator-readable only.
    // OMNI Principal rounds coordinates before writing; Admin receives only privacy-threshold aggregates.
    match /geoPresence/{userId} {
      allow read: if isSystemAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.consent == true
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.locality is string
        && request.resource.data.locality.size() <= 80
        && request.resource.data.province is string
        && request.resource.data.province.size() <= 80
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 80
        && request.resource.data.accuracyBand in ["hasta 100 m", "100 a 500 m", "500 m a 1 km", "más de 1 km"]
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          "uid", "latitude", "longitude", "locality", "province", "country",
          "accuracyBand", "consent", "updatedAt"
        ]);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /usageEvents/{eventId} {
      allow read: if isSystemAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.module is string
        && request.resource.data.event is string
        && request.resource.data.appVersion is string
        && request.resource.data.createdAt is timestamp
        && (!("eventId" in request.resource.data) || request.resource.data.eventId is string)
        && (!("platform" in request.resource.data) || request.resource.data.platform == "android")
        && (!("schemaVersion" in request.resource.data) || request.resource.data.schemaVersion is int)
        && (!("data" in request.resource.data) || (
          request.resource.data.data is map
          && request.resource.data.data.keys().hasOnly([
            "category", "source", "resultCount", "durationMs", "success",
            "itemType", "method", "flow", "surface", "destinationType",
            "screenName", "radiusBucket", "status",
            "operationId", "correlationId", "stage",
            "sessionDurationSeconds", "screenDurationSeconds"
          ])
        ))
        && (!("localHour" in request.resource.data) || (request.resource.data.localHour is int && request.resource.data.localHour >= 0 && request.resource.data.localHour <= 23))
        && (!("localDayOfWeek" in request.resource.data) || (request.resource.data.localDayOfWeek is int && request.resource.data.localDayOfWeek >= 1 && request.resource.data.localDayOfWeek <= 7))
        && (!("timezoneOffsetMinutes" in request.resource.data) || (request.resource.data.timezoneOffsetMinutes is int && request.resource.data.timezoneOffsetMinutes >= -840 && request.resource.data.timezoneOffsetMinutes <= 840))
        && (!("localDate" in request.resource.data) || (request.resource.data.localDate is string && request.resource.data.localDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && request.resource.data.keys().hasOnly([
          "uid", "module", "event", "appVersion", "createdAt", "campaignId",
          "sessionId", "eventId", "platform", "schemaVersion", "data",
          "localHour", "localDayOfWeek", "timezoneOffsetMinutes", "localDate"
        ]);
      allow update, delete: if false;
    }

    match /appFeedback/{feedbackId} {
      allow read: if isSystemAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
